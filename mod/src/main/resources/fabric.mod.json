{
	"schemaVersion": 1,
	"id": "agentcraft",
	"version": "${version}",
	"name": "AgentCraft",
	"description": "A multiplayer Minecraft studio for Claude and Codex coding agents.",
	"authors": [
		"Blendi"
	],
	"license": "MIT",
	"icon": "assets/agentcraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.agentcraft.AgentCraft"
		],
		"client": [
			"dev.agentcraft.client.AgentCraftClient"
		]
	},
	"mixins": [
		"agentcraft.mixins.json",
		{
			"config": "agentcraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"polymer-core": ">=0.18.2"
	}
}
